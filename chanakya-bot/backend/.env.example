# ─────────────────────────────────────────────────────────────────────────────
#  Chanakya Bot — Environment Variables
#  1. Copy this file:   cp .env.example .env
#  2. Fill in values below
#  3. NEVER commit .env to Git — it is in .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# Required — get your free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional — LLM model (default shown, no need to change)
MODEL=llama-3.3-70b-versatile

# Comma-separated list of browser origins allowed to call the API.
# For local development the defaults below work fine.
# For production, change to your actual website domain, e.g:
#   ALLOWED_ORIGINS=https://chanakyauniversity.edu.in
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000

# Admin panel login — set a strong password before starting admin server
ADMIN_USER=admin
ADMIN_PASS=change_this_to_a_strong_password

# Internal URL of main backend (used by admin server health check)
MAIN_API_URL=http://localhost:8000
